# Store text files with LF in the repository and check them out as LF,
# so Windows commits stop printing CRLF warnings and scripts stay portable.
* text=auto eol=lf

# Binary assets: never convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.mp3 binary
*.wav binary
*.ogg binary
